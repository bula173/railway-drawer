{
  "name": "railway-drawer",
  "private": true,
  "version": "0.6.0",
  "author": "Marcin Kwiatkowski",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --version && tsc && vite build --base ./",
    "preview": "vite preview",
    "preview:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src worker tools/mcp-local/src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p tools/mcp-local/tsconfig.json",
    "build:mcp-local": "vite build --config tools/mcp-local/vite.config.ts",
    "drawio:palettes": "node scripts/drawio-palettes/fetch-sources.ts && node scripts/drawio-palettes/decode-stencils-bundle.ts && node scripts/drawio-palettes/vendor-shapes.ts && node scripts/drawio-palettes/extract-palettes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@azure/msal-browser": "5.24.0",
    "@maxgraph/core": "^0.10.0",
    "@modelcontextprotocol/server": "2.3.1",
    "dejavu-fonts-ttf": "2.37.3",
    "jspdf": "4.2.1",
    "roughjs": "4.6.6",
    "svg2pdf.js": "2.8.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "8.20.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "~7.3.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.151.0",
    "ws": "8.22.0"
  }
}

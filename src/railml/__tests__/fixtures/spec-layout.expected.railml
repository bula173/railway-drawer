  <interlocking>
    <assetsForInterlockings>
      <assetsForInterlocking id="ail01">
        <tvdSections>
          <tvdSection id="tvd_TS1" technology="axleCounter">
            <designator register="_RailwayDrawer" entry="TS1"/>
            <hasDemarcatingTraindetector ref="tde_AC1"/>
          </tvdSection>
        </tvdSections>
        <switchesIL>
          <switchIL id="il_sw_W1">
            <designator register="_RailwayDrawer" entry="W1"/>
            <refersTo ref="sw_W1"/>
            <branchLeft ref="trk_T1"/>
            <branchRight ref="trk_T1"/>
          </switchIL>
        </switchesIL>
        <signalsIL>
          <signalIL id="il_sig_S1" function="main">
            <designator register="_RailwayDrawer" entry="S1"/>
            <refersTo ref="sig_S1"/>
          </signalIL>
          <signalIL id="il_sig_S2" function="main">
            <designator register="_RailwayDrawer" entry="S2"/>
            <refersTo ref="sig_S2"/>
          </signalIL>
          <signalIL id="il_sig_S3">
            <designator register="_RailwayDrawer" entry="S3"/>
            <refersTo ref="sig_S3"/>
          </signalIL>
        </signalsIL>
        <routes>
          <route id="rt_R1">
            <designator register="_RailwayDrawer" entry="R1"/>
            <facingSwitchInPosition id="rt_R1_sw_W1" inPosition="right">
              <refersToSwitch ref="il_sw_W1"/>
            </facingSwitchInPosition>
            <routeEntry id="rt_R1_entry">
              <refersTo ref="il_sig_S1"/>
            </routeEntry>
            <routeExit id="rt_R1_exit">
              <refersTo ref="il_sig_S3"/>
            </routeExit>
          </route>
        </routes>
      </assetsForInterlocking>
    </assetsForInterlockings>

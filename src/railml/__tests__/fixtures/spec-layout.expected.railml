          <name name="W1" language="en"/>
          <spotLocation id="sw_W1_sl" netElementRef="ne_T1_1" intrinsicCoord="1"/>
          <designator register="_RailwayDrawer" entry="W1"/>
          <leftBranch netRelationRef="nr_T1_1_T1_2"/>
          <rightBranch netRelationRef="nr_T1_1_W1_1"/>
        </switchIS>
      </switchesIS>
      <tracks>
        <track id="trk_T1" type="mainTrack">
          <name name="Main line" language="en"/>
          <linearLocation id="trk_T1_ll">
            <associatedNetElement netElementRef="ne_T1_1" keepsOrientation="true" intrinsicCoordBegin="0" intrinsicCoordEnd="1" sequence="1"/>
            <associatedNetElement netElementRef="ne_T1_2" keepsOrientation="true" intrinsicCoordBegin="0" intrinsicCoordEnd="1" sequence="2"/>

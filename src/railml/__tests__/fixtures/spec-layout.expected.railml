        <signalIS id="sig_S2" isSwitchable="true">
          <name name="S2" language="en"/>
          <spotLocation id="sig_S2_sl" netElementRef="ne_T1_2" intrinsicCoord="0.875" applicationDirection="normal">
            <linearCoordinate positioningSystemRef="lps01" measure="10550"/>

        </mxCell>
        <mxCell id="e1-lbl" value="1&amp;nbsp;km" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.2" y="1" relative="1" as="geometry">

        "type": {
          "enum": [
            "main",
            "shunting",
            "markerBoard",
            "etcsStopMarker"
          ],
          "description": "Type"
        },
        "direction": {
          "enum": [
            "nominal",
            "reverse"
          ],
          "description": "Direction"
        },
        "at": {
          "$ref": "#/definitions/km",
          "description": "km position on the track (number, or chainage text \"12+345\")"
        },
        "track": {
          "$ref": "#/definitions/id",
          "description": "Track ID (implied inside a track item)"
        },
        "aspects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Aspects"
        },
        "routes": {

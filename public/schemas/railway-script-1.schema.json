          "description": "km position on the track (number, or chainage text \"12+345\")"
        },
        "track": {
          "$ref": "#/definitions/id",
          "description": "Track ID (implied inside a track item)"
        },
        "notes": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Remarks"
        },
        "to": {
          "$ref": "#/definitions/id",
          "description": "Diverging track (its nearer end starts at the points)"
        },
        "type": {
          "type": "string",
          "description": "Points type (free text, e.g. ordinary, slip)"
        },
        "x": {
          "type": "number",
          "description": "Layout override: x of the centre (a track: of its first point), drawing units"
        },
        "y": {
          "type": "number",
          "description": "Layout override: y of the centre (a track: of its line), drawing units"
        }
      }
    },

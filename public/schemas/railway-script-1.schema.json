{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://railwaydrawer.mksystemdesign.org/schemas/railway-script-1.schema.json",
  "title": "Railway Script",
  "description": "Railway Drawer schematic layout language (docs/RAILWAY-SCRIPT.md). YAML or JSON; km based, nominal direction = increasing km = left to right.",
  "type": "object",
  "required": [
    "railwayScript"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL or path of this schema"
    },
    "railwayScript": {
      "const": 1,
      "description": "Railway Script language version (1)"
    },
    "name": {
      "type": "string",
      "description": "Diagram name"
    },
    "page": {
      "$ref": "#/definitions/page"
    },
    "tracks": {
      "type": "array",
      "description": "Tracks",
      "items": {
        "$ref": "#/definitions/track"
      }
    },
    "points": {
      "type": "array",
      "description": "Points",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/points"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "signals": {
      "type": "array",
      "description": "Signals",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/signal"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "baliseGroups": {
      "type": "array",
      "description": "Balise groups",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/baliseGroup"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "balises": {
      "type": "array",
      "description": "Balises",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/balise"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "axleCounters": {
      "type": "array",
      "description": "Axle counters",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/axleCounter"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "description": "Track sections",
      "items": {
        "$ref": "#/definitions/trackSection"
      }
    },
    "levelCrossings": {
      "type": "array",
      "description": "Level crossings",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/levelCrossing"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "bufferStops": {
      "type": "array",
      "description": "Buffer stops",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/bufferStop"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "leus": {
      "type": "array",
      "description": "LEUs",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/leu"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "rbcs": {
      "type": "array",
      "description": "RBCs",
      "items": {
        "$ref": "#/definitions/rbc"
      }
    },
    "trains": {
      "type": "array",
      "description": "Trains",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/train"
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      }
    },
    "routes": {
      "type": "array",
      "description": "Routes",
      "items": {
        "$ref": "#/definitions/route"
      }
    }
  },
  "definitions": {
    "id": {
      "type": [
        "string",
        "number"
      ],
      "minLength": 1,
      "description": "Object ID (unique per kind, case-insensitive)",
      "x-expected": "an ID"
    },
    "idList": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      ],
      "description": "IDs: a list, or text separated by commas",
      "x-expected": "a list of IDs or comma-separated text"
    },
    "km": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^\\s*-?\\d+\\+\\d{1,3}([.,]\\d+)?\\s*$"
        }
      ],
      "description": "km value: a number (12.345) or chainage text (\"12+345\")",
      "x-expected": "a km value (a number such as 12.345, or chainage text such as \"12+345\")"
    },
    "page": {
      "type": "object",
      "description": "Layout options of the generated drawing",
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Drawing units per metre (default 0.5)"
        },
        "laneSpacing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Distance between lanes, drawing units (default 80)"
        },
        "origin": {
          "type": "object",
          "description": "Where the smallest km of lane 0 is drawn (default x 40, y 80)",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      }
    },
    "track": {
      "type": "object",
      "description": "Track: a straight line from startKm to endKm on its lane (nominal direction = increasing km = left to right)",
      "required": [
        "id"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "startKm"
              ]
            },
            {
              "required": [
                "kmStart"
              ]
            },
            {
              "required": [
                "start"
              ]
            },
            {
              "required": [
                "StartPos"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "endKm"
              ]
            },
            {
              "required": [
                "kmEnd"
              ]
            },
            {
              "required": [
                "end"
              ]
            },
            {
              "required": [
                "EndPos"
              ]
            }
          ]
        }
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Track ID"
        },
        "name": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Name"
        },
        "length": {
          "type": "number",
          "minimum": 0,
          "description": "Length [m]"
        },
        "kmStart": {
          "$ref": "#/definitions/km",
          "description": "km start [km]"
        },
        "startKm": {
          "$ref": "#/definitions/km",
          "description": "km start [km]"
        },
        "kmEnd": {
          "$ref": "#/definitions/km",
          "description": "km end [km]"
        },
        "endKm": {
          "$ref": "#/definitions/km",
          "description": "km end [km]"
        },
        "notes": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Remarks"
        },
        "start": {
          "type": "number",
          "description": "Start position in metres (= startKm × 1000)"
        },
        "end": {
          "type": "number",
          "description": "End position in metres (= endKm × 1000)"
        },
        "StartPos": {
          "type": "number",
          "description": "Alias of start (metres)"
        },
        "EndPos": {
          "type": "number",
          "description": "Alias of end (metres)"
        },
        "lane": {
          "type": "integer",
          "description": "Vertical row (0 = top main line, 1 below, -1 above); automatic when omitted"
        },
        "kind": {
          "enum": [
            "main",
            "siding"
          ],
          "description": "main (default) or siding (drawn thinner)"
        },
        "points": {
          "type": "array",
          "description": "Points on this track",
          "items": {
            "$ref": "#/definitions/points"
          }
        },
        "signals": {
          "type": "array",
          "description": "Signals on this track",
          "items": {
            "$ref": "#/definitions/signal"
          }
        },
        "baliseGroups": {
          "type": "array",
          "description": "Balise groups on this track",
          "items": {
            "$ref": "#/definitions/baliseGroup"
          }
        },
        "balises": {
          "type": "array",
          "description": "Balises on this track",
          "items": {
            "$ref": "#/definitions/balise"
          }
        },
        "axleCounters": {
          "type": "array",
          "description": "Axle counters on this track",
          "items": {
            "$ref": "#/definitions/axleCounter"
          }
        },
        "sections": {
          "type": "array",
          "description": "Track sections on this track",
          "items": {
            "$ref": "#/definitions/trackSection"
          }
        },
        "levelCrossings": {
          "type": "array",
          "description": "Level crossings on this track",
          "items": {
            "$ref": "#/definitions/levelCrossing"
          }
        },
        "bufferStops": {
          "type": "array",
          "description": "Buffer stops on this track: \"start\" / \"end\" (ID BS-<track>-start/end) or { id, at: start|end|km }",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "start",
                  "end"
                ]
              },
              {
                "$ref": "#/definitions/bufferStop"
              }
            ],
            "x-expected": "\"start\", \"end\" or { id, at }"
          }
        },
        "leus": {
          "type": "array",
          "description": "LEUs on this track",
          "items": {
            "$ref": "#/definitions/leu"
          }
        },
        "trains": {
          "type": "array",
          "description": "Trains on this track",
          "items": {
            "$ref": "#/definitions/train"
          }
        },
        "x": {
          "type": "number",
          "description": "Layout override: x of the centre (a track: of its first point), drawing units"
        },
        "y": {
          "type": "number",
          "description": "Layout override: y of the centre (a track: of its line), drawing units"
        }
      }
    },
    "points": {
      "type": "object",
      "description": "Points (switch) (railway object kind \"points\")",
      "required": [
        "id",
        "at",
        "to"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Points ID"
